# smart-voca 웹 서비스 환경변수 예시 (배포·운영 설계 §2.1)
# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.

# 실행 환경: local, demo 또는 production. 값이 없으면 production으로 동작해 API 문서를 끈다.
# demo는 ngrok 시연 전용이다. ai-agent/scripts/demo_server.py가 설정하므로 여기에 쓰지 않는다.
APP_ENV=local

# DB 주소 (필수, 없으면 앱이 시작되지 않는다). 개발은 data 폴더의 SQLite 파일을 쓴다.
DATABASE_URL=sqlite:///data/smart_voca.db

# 이메일과 IP 해시에 쓰는 비밀 키 (32자 이상). 운영에서는 필수이고, 개발에서는 비워 두면 개발용 값을 쓴다.
# 만드는 방법: .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_HASH_KEY=

# 메일 링크의 기준 주소. 운영에서는 필수이며 https여야 한다. 개발 기본값은 http://127.0.0.1:8000 이다.
# PUBLIC_BASE_URL=

# 세션 기간 (일). 값이 없으면 절대 14일, 활동 없으면 3일이다.
# SESSION_TTL_ABSOLUTE_DAYS=14
# SESSION_TTL_IDLE_DAYS=3

# 아래 항목은 해당 마일스톤에서 사용하기 시작한다.
# M10 운영 메일 발송 (SMTP_* 또는 MAIL_API_KEY, 업체 선정 후 확정). 그전까지 운영에서는 메일이 발송되지 않는다.
# MAIL_API_KEY=
# M8 소셜 로그인. 키가 있는 제공자만 켜진다 (시연 환경에서는 켜지 않는다).
# 제공자 콘솔에 등록할 콜백 주소: {PUBLIC_BASE_URL}/api/v1/auth/social/google/callback, .../kakao/callback
# 키 값은 이 파일에만 쓰고 채팅·이슈·커밋에 붙여 넣지 않는다.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=

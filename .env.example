# smart-voca 웹 서비스 환경변수 예시 (배포·운영 설계 §2.1)
# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.

# 실행 환경: local 또는 production. 값이 없으면 production으로 동작해 API 문서를 끈다.
APP_ENV=local

# DB 주소 (필수, 없으면 앱이 시작되지 않는다). 개발은 data 폴더의 SQLite 파일을 쓴다.
DATABASE_URL=sqlite:///data/smart_voca.db

# 아래 항목은 해당 마일스톤에서 사용하기 시작한다.
# M2 메일 링크, M8 소셜 콜백
# PUBLIC_BASE_URL=
# M2 세션 기간
# SESSION_TTL_ABSOLUTE_DAYS=14
# SESSION_TTL_IDLE_DAYS=3
# M2 운영 메일 발송 (SMTP_* 또는 MAIL_API_KEY, 업체 선정 후 확정)
# MAIL_API_KEY=
# M8 소셜 로그인
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=
